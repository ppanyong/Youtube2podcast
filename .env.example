# 复制本文件为 .env 后再填写。不要把填好的 .env 提交到 Git。
# ===== LLM 配置（OpenAI 兼容，GLM / OpenAI / 其他均可）=====
# OpenAI:  https://api.openai.com/v1
# 智谱GLM: https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini

# ===== 外部 TTS =====
# TTS_PROVIDER=siliconflow 使用硅基流动 CosyVoice；=edge 使用微软 Edge 在线朗读（无需密钥）
TTS_PROVIDER=siliconflow
# 硅基流动地址写到 /v1 即可，程序会请求 /v1/audio/speech（Edge 模式下可留空）
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_API_KEY=sk-xxxxxxxxxxxxxxxx
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:diana
TTS_SPEED=1.0

# ===== 默认成品位置（网页表单的初始值，仍可在页面里改）=====
OUTPUT_DIR=
ALBUM_NAME=

# ===== 本机网页 =====
HOST=127.0.0.1
PORT=8765
